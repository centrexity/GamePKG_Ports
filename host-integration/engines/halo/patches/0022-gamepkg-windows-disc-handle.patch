+
+/* Selected images arrive as inherited read-only handles. Invalid handles
+ * must never fall back to host path access. The CRT owns only our duplicate. */
+int gamepkg_disc_image_open(const char *path)
+{
+    const char *text = getenv("GAMEPKG_DISC_HANDLE");
+    if (text) {
+        uintptr_t value = 0;
+        size_t count = 0;
+        HANDLE copy = NULL;
+        BY_HANDLE_FILE_INFORMATION information;
+        int descriptor;
+        if (!*text) return -1;
+        for (; text[count]; ++count) {
+            unsigned digit = (unsigned char)text[count] - (unsigned)'0';
+            if (count >= 20 || digit > 9 || value > (UINTPTR_MAX - digit) / 10)
+                return -1;
+            value = value * 10 + digit;
+        }
+        if (!value || value == UINTPTR_MAX ||
+            GetFileType((HANDLE)value) != FILE_TYPE_DISK ||
+            !GetFileInformationByHandle((HANDLE)value, &information) ||
+            (information.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)) return -1;
+        if (!DuplicateHandle(GetCurrentProcess(), (HANDLE)value,
+                GetCurrentProcess(), &copy, FILE_GENERIC_READ, FALSE, 0)) return -1;
+        descriptor = _open_osfhandle((intptr_t)copy, _O_RDONLY | _O_BINARY);
+        if (descriptor < 0) CloseHandle(copy);
+        return descriptor;
+    }
+    return _open(path, _O_RDONLY | _O_BINARY | _O_NOINHERIT);
+}
 
