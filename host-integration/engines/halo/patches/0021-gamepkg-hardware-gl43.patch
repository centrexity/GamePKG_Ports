+/* This renderer owns the context and all query-buffer binds go through
+its GL table. Track this binding rather than querying the driver before
+presentation, which would make a threaded driver catch up with the CPU. */
+static GLuint gamepkg_query_binding;
+static __typeof__(&glBindBuffer) gamepkg_driver_bind_buffer;
+
+static void GLAPIENTRY gamepkg_bind_buffer(GLenum target, GLuint buffer)
+{
+	gamepkg_driver_bind_buffer(target, buffer);
+	if (target == GL_QUERY_BUFFER)
+		gamepkg_query_binding = buffer;
+}
+
+static void GLAPIENTRY gamepkg_create_queries(GLenum target, GLsizei count, GLuint *queries)
+{
+	GLsizei i;
+
+	/* The only caller creates visibility pools before any query is active.
+	GenQueries reserves names; Begin/End also instantiates their target/state,
+	so the existing uniqueness/IsQuery checks remain meaningful. */
+	halo_glGenQueries(count, queries);
+	for (i = 0; i < count; i++)
+	{
+		halo_glBeginQuery(target, queries[i]);
+		halo_glEndQuery(target);
+	}
+}
+
+static void GLAPIENTRY gamepkg_query_buffer(GLuint query, GLuint buffer, GLenum pname, GLintptr offset)
+{
+	GLint previous;
+
+	previous = (GLint)gamepkg_query_binding;
+	halo_glBindBuffer(GL_QUERY_BUFFER, buffer);
+	halo_glGetQueryObjectuiv(query, pname, (GLuint *)offset);
+	halo_glBindBuffer(GL_QUERY_BUFFER, (GLuint)previous);
+}
+
+/* port: bind once per visibility batch on hardware without DSA; never
+ask for the current buffer once per individual query in the frame loop. */
+void gamepkg_gl_query_results(const GLuint *queries, GLuint buffer, GLenum pname,
+	GLintptr offset, GLsizei count)
+{
+	GLsizei i;
+	GLint previous;
+
+	if (gamepkg_gl43_mode)
+	{
+		previous = (GLint)gamepkg_query_binding;
+		halo_glBindBuffer(GL_QUERY_BUFFER, buffer);
+		for (i = 0; i < count; i++)
+			halo_glGetQueryObjectuiv(queries[i], pname, (GLuint *)(offset + i * sizeof(GLuint)));
+		halo_glBindBuffer(GL_QUERY_BUFFER, (GLuint)previous);
+	}
+	else
+	{
+		for (i = 0; i < count; i++)
+			halo_glGetQueryBufferObjectuiv(queries[i], buffer, pname, offset + i * sizeof(GLuint));
+	}
+}
+
+static SDL_FunctionPointer gamepkg_gl_proc(const char *name)
+{
+	if (gamepkg_gl43_mode)
+	{
+		/* The explicit test override also exercises these adapters on newer
+		hardware. Required capabilities are checked before the table is loaded. */
+		if (!strcmp(name, "glBindBuffer"))
+		{
+			gamepkg_driver_bind_buffer = (__typeof__(gamepkg_driver_bind_buffer))SDL_GL_GetProcAddress(name);
+			gamepkg_query_binding = 0;
+			return gamepkg_driver_bind_buffer ? (SDL_FunctionPointer)gamepkg_bind_buffer : NULL;
+		}
+		if (!strcmp(name, "glCreateQueries"))
+			return (SDL_FunctionPointer)gamepkg_create_queries;
+		if (!strcmp(name, "glGetQueryBufferObjectuiv"))
+			return SDL_GL_ExtensionSupported("GL_ARB_query_buffer_object") ?
+				(SDL_FunctionPointer)gamepkg_query_buffer : NULL;
+	}
+	return SDL_GL_GetProcAddress(name);
+}
