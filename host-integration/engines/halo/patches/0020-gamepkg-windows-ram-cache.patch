+#include "gamepkg_ram_cache.h"
+static int gamepkg_ram_mode(const char *path)
+{
+    const char *setting = getenv("GAMEPKG_RAM_CACHE_BYTES");
+    char name[32], *end;
+    unsigned long long bytes;
+    int result;
+    if (!setting || !*setting) return 0;
