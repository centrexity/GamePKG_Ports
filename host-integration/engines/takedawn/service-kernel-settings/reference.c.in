static uint32_t g_eax,g_esp;
#define BRIDGE_MEM32(va) (*(uint32_t*)(arena+(uint32_t)(va)))
static uint32_t stack_arg(uint32_t n){uint32_t v;memcpy(&v,arena+g_esp+4+n*4,4);return v;}
#define STACK_ARG(n) stack_arg(n)
/* PINNED_BRIDGE_EXQUERYNONVOLATILESETTING */
