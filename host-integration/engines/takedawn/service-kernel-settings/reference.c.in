#define XBOX_LOG_DEBUG 0
#define XBOX_LOG_WARN 2
#define XBOX_LOG_XBOX 0
static uint32_t logs[6];
static void xbox_log(int level,int tag,const char *format,...) {
 (void)tag;(void)format;va_list args;va_start(args,format);uint32_t index=va_arg(args,uint32_t);
 if(level==XBOX_LOG_DEBUG){logs[0]++;logs[1]=(uint32_t)level;logs[2]=index;logs[3]=va_arg(args,uint32_t);}
 else{logs[0]++;logs[4]=(uint32_t)level;logs[5]=index;}
 va_end(args);
}
