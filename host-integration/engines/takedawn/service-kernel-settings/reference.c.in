void settings_reference_reset(uint8_t *ram,uint32_t video,uint32_t speakers){arena=ram;g_xbox_mem_offset=(uintptr_t)ram;title_channels=(int)speakers;xbox_SetVideoSettings(video,0);memset(logs,0,sizeof(logs));}
void settings_reference_call(uint32_t *eax,uint32_t *esp){g_eax=*eax;g_esp=*esp;bridge_ExQueryNonVolatileSetting();*eax=g_eax;*esp=g_esp+4+stdcall_args_for_ordinal(24);}
void settings_reference_logs(uint32_t *out){memcpy(out,logs,sizeof(logs));}
