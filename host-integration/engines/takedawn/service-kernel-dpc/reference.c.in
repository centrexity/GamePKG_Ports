/* Maintainer-only pinned queue oracle. No actual OS/thread/callback provider. */
#include <stdint.h>
#include <string.h>
typedef int32_t LONG;
typedef struct{uint32_t dpc,arg1,arg2;uint64_t t_ns;}PendingDpc;
#define XBOX_MAX_PENDING_DPC 64
static PendingDpc g_dpc_queue[64];
static LONG g_dpc_head,g_dpc_tail;
static uint8_t memory[65536];
static uint32_t args[3],g_eax,full;
static int stats,t_dpc_timer_thread,clock_reads;
static uint64_t now;
static int g_dpc_lock;
#define STACK_ARG(n) args[(n)]
#define BRIDGE_MEM8(address) memory[(uint32_t)(address)-0x740000u]
static void kernel_dpc_hooks_once(void){}
static void dpc_lock(void){}
static void LeaveCriticalSection(int *lock){(void)lock;}
static int dpc_stats_on(void){return stats;}
static uint64_t xbox_HostNowNs(void){clock_reads++;return now;}
static void xbox_DpcQueued(void){}
static int reference_print(void *stream,const char *format,...){(void)stream;(void)format;full=1;return 0;}
static int reference_flush(void *stream){(void)stream;return 0;}
#define fprintf reference_print
#define fflush reference_flush
#define stderr ((void*)0)
/* PINNED_INSERT */
/* PINNED_REMOVE */
/* PINNED_PENDING */
static uint64_t hash_bytes(uint64_t h,const uint8_t *p,uint32_t n){for(uint32_t i=0;i<n;i++)h=(h^p[i])*1099511628211ull;return h;}
static void put64(uint8_t *p,uint64_t value){for(int n=0;n<8;n++)p[n]=(uint8_t)(value>>(n*8));}
static void put32(uint8_t *p,uint32_t value){for(int n=0;n<4;n++)p[n]=(uint8_t)(value>>(n*8));}
void dpc_reference_init(int enabled){stats=enabled;memset(memory,0xa5,sizeof(memory));for(uint32_t i=0;i<64;i++)memory[0x102+i*32]=0;}
void dpc_reference(uint32_t op,uint32_t dpc,uint32_t first,uint32_t second,uint64_t timestamp,uint8_t *out){
    uint64_t value[5]={0,0,0,0,0};full=0;clock_reads=0;now=timestamp;
    args[0]=dpc;args[1]=first;args[2]=second;
    if(op==0){bridge_KeInsertQueueDpc();value[0]=g_eax;value[1]=full;}
    else if(op==1){bridge_KeRemoveQueueDpc();value[0]=g_eax;}
    else if(g_dpc_head!=g_dpc_tail){
        PendingDpc d;
/* PINNED_POP_PREFIX */
        value[0]=1;value[1]=d.dpc;value[2]=d.arg1;value[3]=d.arg2;value[4]=d.t_ns;
    }
    uint8_t ring[1552]={0};put64(ring,(uint64_t)g_dpc_head);put64(ring+8,(uint64_t)g_dpc_tail);
    for(int slot=0;slot<64;slot++){uint8_t *p=ring+16+slot*24;put32(p,g_dpc_queue[slot].dpc);put32(p+4,g_dpc_queue[slot].arg1);put32(p+8,g_dpc_queue[slot].arg2);put64(p+16,g_dpc_queue[slot].t_ns);}
    put64(out,hash_bytes(14695981039346656037ull,memory,65536));put64(out+8,hash_bytes(14695981039346656037ull,ring,1552));
    for(int n=0;n<5;n++)put64(out+16+n*8,value[n]);
    put64(out+56,(uint64_t)kernel_dpc_pending());put64(out+64,(uint64_t)clock_reads);
}
