/* Original callback calling convention with controlled native/profiler/IRQL providers. */
#include <stdint.h>
#include <stddef.h>
#include <stdio.h>
#include <string.h>
#include <assert.h>
#include <stdlib.h>
static uint32_t cpu[79],ram[131072];
static int irql,profile_on,samples;
#define BRIDGE_MEM32(va) ram[((uint32_t)(va)-0x740000u)/4u]
#define g_esp cpu[7]
typedef void (*recomp_func_t)(void);
static void trace(uint32_t kind) {
 uint32_t n=BRIDGE_MEM32(0x741000);assert(n<64);
 uint32_t v[8]={kind,(uint32_t)irql,g_esp,cpu[60],BRIDGE_MEM32(0x741020),BRIDGE_MEM32(0x741024),BRIDGE_MEM32(0x741038),BRIDGE_MEM32(0x74103c)};
 memcpy((uint8_t *)ram+0x3000+n*32,v,32);BRIDGE_MEM32(0x741000)=n+1;
}
static void publish(int level) {irql=level;if(cpu[60])BRIDGE_MEM32(cpu[60]+0x24)=(BRIDGE_MEM32(cpu[60]+0x24)&0xffffff00u)|(uint32_t)level;}
static int xbox_IrqlEnterInterrupt(int level) {int old=irql;if(irql!=level)publish(level);return old;}
static void xbox_IrqlLeaveInterrupt(int saved) {if(irql!=saved)publish(saved);}
static int xbox_ProfOn(void) {return profile_on;}
static void *xbox_ProfBegin(int kind,uint32_t routine) {samples=0;BRIDGE_MEM32(0x741020)=(uint32_t)kind;BRIDGE_MEM32(0x741024)=routine;trace(1);return (void *)(uintptr_t)1;}
static long long xbox_ProfNowUs(void) {if(samples++==0)trace(2);return 100+(samples-1)*2;}
static void xbox_ProfEnd(void *prev,long long elapsed) {assert((uintptr_t)prev==1 && elapsed==2);trace(4);}
static void queue_self(uint32_t dpc,uint32_t first,uint32_t second);
static void native(uint32_t routine) {
 trace(3);assert(BRIDGE_MEM32(g_esp)==0);
 uint32_t dpc=BRIDGE_MEM32(g_esp+4),context=BRIDGE_MEM32(g_esp+8),first=BRIDGE_MEM32(g_esp+12),second=BRIDGE_MEM32(g_esp+16);
 assert(BRIDGE_MEM32(dpc+20)==first && BRIDGE_MEM32(dpc+24)==second);
 cpu[0]^=routine^context;cpu[3]=first;cpu[4]=second;
 cpu[56]=first;cpu[57]=second;cpu[58]=context;cpu[59]=dpc;
 cpu[69]=routine;cpu[70]=context;cpu[61]^=0x844;cpu[62]=UINT32_MAX;cpu[11]=(cpu[11]&0xffff0000u)|0x4000;
 uint32_t mode=BRIDGE_MEM32(0x741010);
 if(mode>=2)cpu[60]=0x742000;
 if(mode==1)publish(0);
 if(mode==2)publish(4);
 if(mode==3)publish(1);
 BRIDGE_MEM32(0x744000)=cpu[0];
 if(BRIDGE_MEM32(0x741050) && !BRIDGE_MEM32(0x741054)){BRIDGE_MEM32(0x741054)=1;queue_self(dpc,first+1,second+1);}
 g_esp+=20;
}
static void primary(void) {native(0x1100);}
static void secondary(void) {native(0x2200);}
static recomp_func_t recomp_lookup(uint32_t address) {return address==0x1100?primary:NULL;}
static recomp_func_t recomp_lookup_manual(uint32_t address) {return address==0x2200?secondary:NULL;}

/* PINNED_RUN */
typedef struct {uint32_t dpc,arg1,arg2;uint64_t t_ns;} PendingDpc;
#define XBOX_MAX_PENDING_DPC 64
#define XBOX_PROF_DRAIN_BUSY 1
#define XBOX_PROF_DPCQ_DEPTH 2
#define XBOX_PROF_DPC_QUEUE 77
#define RENV_DPC_VBLANK_GUARD 1
#define RENV_DPC_LAG 2
#define BRIDGE_MEM8(va) ((uint8_t *)ram)[(uint32_t)(va)-0x740000u]
static PendingDpc g_dpc_queue[64];static int g_dpc_head,g_dpc_tail,g_dpc_lock;
static int gate_busy,gate_depth;static int32_t configured_lag;static char guard_text[64];static int default_guard;
static const char *recomp_env(int key){return key==RENV_DPC_LAG?"configured":(default_guard?NULL:guard_text);}
static int recomp_env_int(int key,int fallback){(void)key;(void)fallback;return configured_lag;}
static int xbox_DispatchGateTryEnter(void){if(gate_busy)return 0;gate_depth++;return 1;}
static void xbox_DispatchGateLeave(void){assert(gate_depth>0);gate_depth--;}
static void dpc_lock(void){assert(!g_dpc_lock);g_dpc_lock=1;}
static void LeaveCriticalSection(int *lock){assert(*lock);*lock=0;}
static uint64_t read64(uint32_t at){return (uint64_t)BRIDGE_MEM32(at)|((uint64_t)BRIDGE_MEM32(at+4)<<32);}
static void write64(uint32_t at,uint64_t value){BRIDGE_MEM32(at)=(uint32_t)value;BRIDGE_MEM32(at+4)=(uint32_t)(value>>32);}
static uint64_t xbox_HostNowNs(void){uint32_t n=BRIDGE_MEM32(0x741070)++;return read64(0x741060)+(uint64_t)n*read64(0x741068);}
static uint64_t xbox_GuestNowNs(void){uint32_t n=BRIDGE_MEM32(0x741088)++;return read64(0x741078)+(uint64_t)n*read64(0x741080);}
static void metric(uint32_t kind,uint64_t value){write64(0x741038,value);trace(kind);}
static void xbox_ProfCount(int kind,int value){
 if(kind==XBOX_PROF_DRAIN_BUSY){assert(!gate_depth);metric(6,(uint32_t)value);}
 else {assert(kind==XBOX_PROF_DPCQ_DEPTH && g_dpc_lock);uint32_t dpc=g_dpc_queue[g_dpc_head].dpc;uint64_t flag=dpc?BRIDGE_MEM8(dpc+2):0;metric(7,(uint32_t)value|((uint64_t)(g_dpc_head*256+flag)<<32));}
}
static void dpc_stats_ran(uint64_t timestamp){assert(!g_dpc_lock);metric(8,timestamp);}
static void queue_self(uint32_t dpc,uint32_t first,uint32_t second){
 int next=(g_dpc_tail+1)%64;assert(next!=g_dpc_head && !BRIDGE_MEM8(dpc+2));
 g_dpc_queue[g_dpc_tail]=(PendingDpc){dpc,first,second,0};BRIDGE_MEM8(dpc+2)=1;g_dpc_tail=next;
}
/* PINNED_DRAINS */
static void put32(uint8_t *out,uint32_t value){for(unsigned i=0;i<4;i++)out[i]=(uint8_t)(value>>(8*i));}
static void put64(uint8_t *out,uint64_t value){for(unsigned i=0;i<8;i++)out[i]=(uint8_t)(value>>(8*i));}
static uint64_t hash_bytes(const uint8_t *bytes,size_t length){uint64_t hash=UINT64_C(14695981039346656037);for(size_t i=0;i<length;i++)hash=(hash^bytes[i])*UINT64_C(1099511628211);return hash;}
void drain_reference(uint32_t group,uint32_t step,const uint8_t *initial,int64_t guard_us,int32_t lag,const uint64_t *values,uint8_t *out){
 if(step==0){
  memset(ram,0,sizeof(ram));memcpy(cpu,initial,316);memset(g_dpc_queue,0,sizeof(g_dpc_queue));irql=0;samples=0;gate_depth=0;g_dpc_lock=0;
  g_dpc_head=g_dpc_tail=(int)((group*17)%64);profile_on=(int)((group>>1)&1);BRIDGE_MEM32(0x741004)=(uint32_t)profile_on;BRIDGE_MEM32(0x741010)=(group>>2)&3;BRIDGE_MEM32(0x741050)=group%5==0;
  configured_lag=lag;default_guard=group%6==2;snprintf(guard_text,sizeof(guard_text),"%lld",(long long)guard_us);
  static const uint32_t counts[4]={0,1,3,5};uint32_t count=counts[group/24];
  for(uint32_t slot=0;slot<count;slot++){
   uint32_t dpc=0x740100+slot*32;BRIDGE_MEM32(dpc+12)=slot==2?0:(slot&1?0x2200:0x1100);BRIDGE_MEM32(dpc+16)=0xa54e12b8u+group*17+slot;
   g_dpc_queue[g_dpc_tail]=(PendingDpc){dpc,0x11223344u^slot,0xff004400u-slot*31,group%3==0?1+(uint64_t)slot*100:0};BRIDGE_MEM8(dpc+2)=1;g_dpc_tail=(g_dpc_tail+1)%64;
  }
  if(count>=3){g_dpc_queue[(g_dpc_head+1)%64].dpc=0;BRIDGE_MEM8(0x740122)=0;}
 }
 write64(0x741060,values[0]);write64(0x741068,0);BRIDGE_MEM32(0x741070)=0;write64(0x741078,values[1]);write64(0x741080,values[2]);BRIDGE_MEM32(0x741088)=0;
 gate_busy=step==1 && group%7==0;int ran=0,status=0;
 switch(group){
 /* DRAIN_CASES */
 default:assert(0);
 }
 assert(gate_depth==0 && !g_dpc_lock);memcpy(out,cpu,316);put64(out+316,hash_bytes((const uint8_t *)ram,sizeof(ram)));
 uint8_t ring[1552]={0};put64(ring,(uint64_t)g_dpc_head);put64(ring+8,(uint64_t)g_dpc_tail);
 for(unsigned slot=0;slot<64;slot++){uint8_t *p=ring+16+slot*24;put32(p,g_dpc_queue[slot].dpc);put32(p+4,g_dpc_queue[slot].arg1);put32(p+8,g_dpc_queue[slot].arg2);put64(p+16,g_dpc_queue[slot].t_ns);}
 put64(out+324,hash_bytes(ring,sizeof(ring)));put32(out+332,(uint32_t)status);put32(out+336,(uint32_t)ran);put32(out+340,BRIDGE_MEM32(0x741070));put32(out+344,BRIDGE_MEM32(0x741088));put32(out+348,(uint32_t)irql);
}
