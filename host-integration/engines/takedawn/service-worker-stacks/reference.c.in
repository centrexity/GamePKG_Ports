/* Maintainer-only original allocator bodies; no platform/device calls. */
#include <stdint.h>
#include <string.h>
typedef int32_t LONG;
static uint32_t stack_base,stack_size;
#define XBOX_WORKER_STACK_COUNT 16
#define XBOX_WORKER_STACK_SIZE (256*1024)
#define XBOX_STACK_SIZE stack_size
#define XBOX_WORKER_STACK_TOP(n) (stack_base+XBOX_WORKER_STACK_SIZE*((n)+1)-16)
static volatile LONG g_worker_stack_used[XBOX_WORKER_STACK_COUNT];
static LONG InterlockedCompareExchange(volatile LONG *p,LONG value,LONG expected){LONG old=*p;if(old==expected)*p=value;return old;}
static LONG InterlockedExchange(volatile LONG *p,LONG value){LONG old=*p;*p=value;return old;}
/* PINNED_XBOX_WORKER_STACK_ALLOC */
/* PINNED_XBOX_WORKER_STACK_FREE */
void stacks_reference(uint32_t index,uint8_t *out){
 const uint32_t sizes[8]={0,65536,196608,262144,1048576,8*1048576,5*262144+65536,7*262144};
 stack_base=(index&8)?0x1000000:0x780000;stack_size=sizes[index%8];
 for(unsigned s=0;s<16;s++)g_worker_stack_used[s]=0;
 for(unsigned step=0;step<128;step++){
  uint32_t random=index*1664525u+step*1013904223u;
  unsigned operation=step<32?0:(step>=64&&step<96?1:random&1);
  unsigned slot=step>=64&&step<96?(step-64)%16:(random>>16)%16;
  int result=0;uint64_t top=0,mask=0,count=0;
  if(operation==0){result=xbox_worker_stack_alloc();if(result>=0)top=XBOX_WORKER_STACK_TOP((unsigned)result);}
  else xbox_worker_stack_free((int)slot);
  for(unsigned s=0;s<16;s++)if(g_worker_stack_used[s]){mask|=UINT64_C(1)<<s;count++;}
  uint64_t values[4]={(uint64_t)(int64_t)result,top,mask,count};
  for(unsigned lane=0;lane<4;lane++)for(unsigned b=0;b<8;b++)out[step*32+lane*8+b]=(uint8_t)(values[lane]>>(8*b));
 }
}
