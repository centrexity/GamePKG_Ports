# Private Windows native runtime connection. A player kit is not promoted until
# full native link, process isolation and gameplay qualification pass.
function(gamepkg_attach_windows_disc_media)
    if(NOT TARGET burnout3 OR NOT TARGET xbox_kernel OR NOT TARGET recomp_env OR NOT TARGET xbox_usb OR (NOT TARGET xbox_overlay AND NOT TARGET gamepkg_takedawn_settings))
        message(FATAL_ERROR "The reviewed native game/kernel/overlay targets are required")
    endif()
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "Clang")
        message(FATAL_ERROR "The full reviewed Windows runtime uses Clang native TLS")
    endif()
    set(bridge "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    if(NOT DEFINED GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE OR NOT EXISTS "${GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE}")
        message(FATAL_ERROR "Set GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE to the Windows Rust media static library")
    endif()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/gamepkg-media")
    get_target_property(restart_dir recomp_env SOURCE_DIR)
    get_target_property(restart_sources recomp_env SOURCES)
    list(FIND restart_sources recomp_restart.c restart_index)
    if(restart_index LESS 0)
        message(FATAL_ERROR "Pinned restart target entry is missing")
    endif()
    set(restart "${CMAKE_BINARY_DIR}/gamepkg-media/recomp_restart.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${restart_dir}/recomp_restart.c"
        "-DOUTPUT=${restart}" -P "${bridge}/adapt_windows_restart.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT restart_sources ${restart_index})
    list(APPEND restart_sources "${restart}")
    # The clock's 10MHz fast path is integer-identical to the original split
    # conversion. All other frequencies keep the pinned implementation.
    list(FIND restart_sources host_time.c clock_index)
    if(clock_index LESS 0)
        message(FATAL_ERROR "Pinned host clock target entry is missing")
    endif()
    set(clock "${CMAKE_BINARY_DIR}/gamepkg-media/host_time.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${restart_dir}/host_time.c"
        "-DOUTPUT=${clock}" -P "${bridge}/adapt_windows_clock.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT restart_sources ${clock_index})
    list(APPEND restart_sources "${clock}")
    set_property(TARGET recomp_env PROPERTY SOURCES "${restart_sources}")
    get_target_property(kernel_dir xbox_kernel SOURCE_DIR)
    get_target_property(kernel_sources xbox_kernel SOURCES)
    foreach(kind IN ITEMS path memory file)
        if(kind STREQUAL "memory")
            set(name xbox_memory_layout.c)
        else()
            set(name kernel_${kind}.c)
        endif()
        list(FIND kernel_sources "${name}" index)
        if(index LESS 0)
            message(FATAL_ERROR "Pinned ${name} target entry is missing")
        endif()
        set(staged "${CMAKE_BINARY_DIR}/gamepkg-media/${name}")
        if(kind STREQUAL "file")
            set(adapter "${bridge}/adapt_windows_file.cmake")
        elseif(kind STREQUAL "path")
            set(adapter "${bridge}/adapt_paths.cmake")
        else()
            set(adapter "${bridge}/adapt_memory.cmake")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${kernel_dir}/${name}"
            "-DOUTPUT=${staged}" -DWINDOWS_LAYOUT=ON -P "${adapter}" COMMAND_ERROR_IS_FATAL ANY)
        list(REMOVE_AT kernel_sources ${index})
        list(APPEND kernel_sources "${staged}")
    endforeach()
    list(FIND kernel_sources "kernel_pacing.c" pacing_index)
    if(pacing_index LESS 0)
        message(FATAL_ERROR "Pinned kernel pacing source target is missing")
    endif()
    set(adapted_pacing "${CMAKE_BINARY_DIR}/gamepkg-media/kernel_pacing.c")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DINPUT=${kernel_dir}/kernel_pacing.c" "-DOUTPUT=${adapted_pacing}"
        -P "${bridge}/adapt_pacing.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT kernel_sources ${pacing_index})
    list(APPEND kernel_sources "${adapted_pacing}")
    list(FIND kernel_sources "kernel_bridge.c" thread_index)
    if(thread_index LESS 0)
        message(FATAL_ERROR "Pinned kernel bridge source target is missing")
    endif()
    set(adapted_threads "${CMAKE_BINARY_DIR}/gamepkg-media/kernel_bridge.c")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DINPUT=${kernel_dir}/kernel_bridge.c" "-DOUTPUT=${adapted_threads}"
        -P "${bridge}/adapt_threads.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT kernel_sources ${thread_index})
    list(APPEND kernel_sources "${adapted_threads}")
    list(FIND kernel_sources "nv2a_pb_exec.c" gpu_report_index)
    if(gpu_report_index LESS 0)
        message(FATAL_ERROR "Pinned GPU executor source target is missing")
    endif()
    set(adapted_gpu_report "${CMAKE_BINARY_DIR}/gamepkg-media/nv2a_pb_exec.c")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DINPUT=${kernel_dir}/nv2a_pb_exec.c" "-DOUTPUT=${adapted_gpu_report}"
        -DTRACK_CONSTANTS=${GAMEPKG_TAKEDAWN_NATIVE_RENDERER}
        -P "${bridge}/adapt_gpu_report.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT kernel_sources ${gpu_report_index})
    list(APPEND kernel_sources "${adapted_gpu_report}")
    set_property(TARGET xbox_kernel PROPERTY SOURCES "${kernel_sources}")
    target_include_directories(xbox_kernel PRIVATE "${kernel_dir}")
    get_target_property(game_dir burnout3 SOURCE_DIR)
    get_target_property(game_sources burnout3 SOURCES)
    list(FIND game_sources main.c main_index)
    if(main_index LESS 0)
        message(FATAL_ERROR "Pinned native main target entry is missing")
    endif()
    set(main "${CMAKE_BINARY_DIR}/gamepkg-media/main.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${game_dir}/main.c"
        "-DOUTPUT=${main}" -DKIND=main -P "${bridge}/adapt_windows_startup.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT game_sources ${main_index})
    list(APPEND game_sources "${main}")
    list(FIND game_sources shaderbuild.c shaderbuild_index)
    if(shaderbuild_index LESS 0)
        message(FATAL_ERROR "Pinned shader builder target entry is missing")
    endif()
    set(shaderbuild "${CMAKE_BINARY_DIR}/gamepkg-media/shaderbuild.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${game_dir}/shaderbuild.c"
        "-DOUTPUT=${shaderbuild}" -P "${bridge}/adapt_windows_shaderbuild.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT game_sources ${shaderbuild_index})
    list(APPEND game_sources "${shaderbuild}")
    set_property(TARGET burnout3 PROPERTY SOURCES "${game_sources}")
    target_include_directories(burnout3 PRIVATE "${game_dir}")
    if(TARGET xbox_overlay)
    get_target_property(overlay_dir xbox_overlay SOURCE_DIR)
    get_target_property(overlay_sources xbox_overlay SOURCES)
    list(FIND overlay_sources overlay_gamefont.cpp font_index)
    if(font_index LESS 0)
        message(FATAL_ERROR "Pinned native font target entry is missing")
    endif()
    set(font "${CMAKE_BINARY_DIR}/gamepkg-media/overlay_gamefont.cpp")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${overlay_dir}/overlay_gamefont.cpp"
        "-DOUTPUT=${font}" -DKIND=font -P "${bridge}/adapt_windows_startup.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT overlay_sources ${font_index})
    list(APPEND overlay_sources "${font}")
    set_property(TARGET xbox_overlay PROPERTY SOURCES "${overlay_sources}")
    target_include_directories(xbox_overlay PRIVATE "${overlay_dir}")
    endif()
    get_target_property(d3d_dir xbox_d3d8 SOURCE_DIR)
    get_target_property(d3d_sources xbox_d3d8 SOURCES)
    list(FIND d3d_sources nv2a_pcache.c pcache_index)
    if(pcache_index LESS 0)
        message(FATAL_ERROR "Pinned shader cache target entry missing")
    endif()
    set(pcache "${CMAKE_BINARY_DIR}/gamepkg-media/nv2a_pcache.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${d3d_dir}/nv2a_pcache.c"
        "-DOUTPUT=${pcache}" -P "${bridge}/adapt_windows_pcache.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT d3d_sources ${pcache_index})
    list(APPEND d3d_sources "${pcache}")
    set_property(TARGET xbox_d3d8 PROPERTY SOURCES "${d3d_sources}")
    target_include_directories(xbox_d3d8 PRIVATE "${d3d_dir}" "${bridge}")
    get_target_property(usb_dir xbox_usb SOURCE_DIR)
    get_target_property(usb_sources xbox_usb SOURCES)
    list(FIND usb_sources ohci.c ohci_index)
    if(ohci_index LESS 0)
        message(FATAL_ERROR "Pinned USB worker target entry missing")
    endif()
    set(ohci "${CMAKE_BINARY_DIR}/gamepkg-media/ohci.c")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${usb_dir}/ohci.c"
        "-DOUTPUT=${ohci}" -P "${bridge}/adapt_ohci_startup.cmake" COMMAND_ERROR_IS_FATAL ANY)
    list(REMOVE_AT usb_sources ${ohci_index})
    list(APPEND usb_sources "${ohci}")
    set_property(TARGET xbox_usb PROPERTY SOURCES "${usb_sources}")
    target_include_directories(xbox_usb PRIVATE "${usb_dir}")
    find_package(SDL2 REQUIRED) # windows_stream.c owns an SDL RWops adapter
    target_link_libraries(burnout3 PRIVATE SDL2::SDL2)
    target_link_libraries(burnout3 PRIVATE "-Wl,-Bstatic" winpthread "-Wl,-Bdynamic")
    add_library(gamepkg_windows_disc_support STATIC "${bridge}/windows_file.c" "${bridge}/windows_stream.c")
    target_include_directories(gamepkg_windows_disc_support PUBLIC "${bridge}")
    target_link_libraries(gamepkg_windows_disc_support PUBLIC SDL2::SDL2 "${GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE}" ws2_32 userenv bcrypt ntdll)
    target_link_libraries(xbox_kernel PUBLIC gamepkg_windows_disc_support)
    target_sources(burnout3 PRIVATE "${bridge}/windows_entry.c")
    target_link_libraries(burnout3 PRIVATE "${GAMEPKG_TAKEDAWN_MEDIA_ARCHIVE}" ws2_32 userenv bcrypt ntdll)
    target_link_options(burnout3 PRIVATE -static-libgcc)
    set_target_properties(burnout3 PROPERTIES OUTPUT_NAME "burnout3-gamepkg-media")
    if(GAMEPKG_PRIVATE_RENDER_TEST AND TARGET d3d11_backend_smoke)
        set_property(TARGET d3d11_backend_smoke PROPERTY SOURCES "${bridge}/native_d3d11_fixture.c")
        target_link_options(d3d11_backend_smoke PRIVATE -static-libgcc)
    endif()
endfunction()
