# Keep all decoding and rendering; suppress only windows disabled by the host.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT DEFINED KIND)
    message(FATAL_ERROR "Set INPUT, OUTPUT and KIND")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned native presentation source")
endif()
file(SHA256 "${INPUT}" hash)
if(KIND STREQUAL "fb_present")
    set(expected "38c8428be72d9e55099f09c82c3819407ccc489a126e40851ea1f0defc3979d8")
    set(before "    if (!recomp_env(RENV_FB_WINDOW))\n        return;")
    set(after "    if (recomp_env_on(RENV_HEADLESS) || !recomp_env_on(RENV_FB_WINDOW))\n        return;")
elseif(KIND STREQUAL "video_pump")
    set(expected "b4c9fc8d72144656c33cdd07e8c8b03f4149e1139808694d19ddf7e081234c15")
    set(before "                           WS_OVERLAPPEDWINDOW | WS_VISIBLE,")
    set(after "                           WS_OVERLAPPEDWINDOW | (recomp_env_on(RENV_HEADLESS) ? 0 : WS_VISIBLE),")
else()
    message(FATAL_ERROR "Unsupported native presentation source")
endif()
if(NOT hash STREQUAL expected)
    message(FATAL_ERROR "Unreviewed native presentation source")
endif()
file(READ "${INPUT}" source)
string(REPLACE "${before}" "${after}" adapted "${source}")
if(adapted STREQUAL source)
    message(FATAL_ERROR "Pinned native presentation adaptation point is missing")
endif()
file(WRITE "${OUTPUT}.tmp" "${adapted}")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
