if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "Set INPUT and OUTPUT")
endif()
get_filename_component(input_real "${INPUT}" REALPATH)
get_filename_component(output_real "${OUTPUT}" REALPATH)
if(input_real STREQUAL output_real)
    message(FATAL_ERROR "Never overwrite pinned input source")
endif()
file(SHA256 "${INPUT}" hash)
if(NOT hash STREQUAL "b3de071261f4f35f947dd7121bc99183b55b2560bd38ff11ce394fbd5946498c")
    message(FATAL_ERROR "Unreviewed native D3D11 keyboard source")
endif()
file(READ "${INPUT}" source)
function(replace_exact before after)
    string(FIND "${source}" "${before}" location)
    if(location LESS 0)
        message(FATAL_ERROR "Pinned native keyboard adaptation point missing: ${before}")
    endif()
    string(REPLACE "${before}" "${after}" source "${source}")
    set(source "${source}" PARENT_SCOPE)
endfunction()
replace_exact("extern void xbox_InputSetBackground(int on);    /* src/input/input_core.c */"
    "extern void xbox_InputSetBackground(int on);    /* src/input/input_core.c */\n#include \"native_win32_keyboard.h\"")
replace_exact("        xbox_InputKeySet((int)w, 1);" "        gamepkg_native_win32_key_down(w, l);")
replace_exact("        xbox_InputKeySet((int)w, 0);" "        gamepkg_native_win32_key_up(w, l);")
replace_exact("        xbox_InputKeysClear();\n        xbox_InputSetBackground(1);"
    "        gamepkg_native_win32_focus(0);")
replace_exact("        xbox_InputSetBackground(0);" "        gamepkg_native_win32_focus(1);")
replace_exact("    case WM_SETFOCUS:"
    "    case WM_CHAR:\n        gamepkg_win32_keyboard_message(m, w, l);\n        return 0;\n    case WM_UNICHAR:\n        if (w == UNICODE_NOCHAR) return TRUE;\n        gamepkg_win32_keyboard_message(m, w, l);\n        return 0;\n    case WM_SETFOCUS:")
replace_exact("    if (m == WM_CLOSE) {" "    if (m == WM_CLOSE) {\n        gamepkg_native_win32_focus(0);")
replace_exact("    if (m == WM_SIZE && w != SIZE_MINIMIZED && LOWORD(l) && HIWORD(l)) {"
