typedef struct {LONG posted[3],on_holder[3],second_try[3],forced[3],ungated[3],max_wait_us[3],wait_logs,refused;} XboxIrqStats;
static LONG InterlockedOr(volatile LONG *p,LONG bits){LONG old=*p;*p=old|bits;return old;}
static LONG InterlockedAnd(volatile LONG *p,LONG bits){LONG old=*p;*p=old&bits;return old;}
static uint64_t xbox_HostNowNs(void){uint64_t value=0;for(unsigned i=0;i<8;i++)value|=(uint64_t)memory[0x1008+i]<<(i*8);return value;}
static void mem_word(unsigned at,uint32_t value){for(unsigned i=0;i<4;i++)memory[at+i]=(uint8_t)(value>>(i*8));}
static uint32_t mem_get(unsigned at){return (uint32_t)memory[at]|(uint32_t)memory[at+1]<<8|(uint32_t)memory[at+2]<<16|(uint32_t)memory[at+3]<<24;}
static void counter(unsigned at){mem_word(at,mem_get(at)+1);}
static void xbox_log(int level,int area,const char *text,...){(void)level;(void)area;(void)text;counter(0x1014);}
static void xbox_SpinWake(void){counter(0x1010);}
static void dpc_release_point(void){counter(0x1018);}
static void irq_config(void){s_irq_mode=1;s_irq_force=0;s_irq_wait_ns=250000000;}
static void (*s_irq_release_hook)(void);
static void (*s_irq_post_hook)(int);
