static LONG InterlockedCompareExchange(volatile LONG *p,LONG value,LONG expected){LONG old=*p;if(old==expected)*p=value;return old;}
static LONG InterlockedExchange(volatile LONG *p,LONG value){LONG old=*p;*p=value;return old;}
static LONG delta(volatile LONG *p,uint32_t d){uint32_t n;memcpy(&n,(const void *)p,4);n+=d;memcpy((void *)p,&n,4);return *p;}
static LONG InterlockedIncrement(volatile LONG *p){return delta(p,1);}
static LONG InterlockedDecrement(volatile LONG *p){return delta(p,UINT32_MAX);}
