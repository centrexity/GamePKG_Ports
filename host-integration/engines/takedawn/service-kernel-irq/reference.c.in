typedef union {float f[4];double d[2];uint32_t u[4];int32_t i[4];uint64_t q[2];} RecompXmm;
typedef union {uint32_t u[2];uint64_t q;} RecompMmx;
static uint32_t g_eax,g_ecx,g_edx,g_ebx,g_esi,g_edi,g_ebp,g_esp,g_seh_ebp,g_eflags,g_fs_base;
static int g_df,g_fp_top,g_fp_cmp;
static double g_fp_stack[8];static uint16_t g_fp_control_word,g_fp_cc;
static RecompXmm g_xmm0,g_xmm1,g_xmm2,g_xmm3,g_xmm4,g_xmm5,g_xmm6,g_xmm7;
static RecompMmx g_mm0,g_mm1,g_mm2,g_mm3,g_mm4,g_mm5,g_mm6,g_mm7;

