static uint32_t get32(const uint8_t *p){return (uint32_t)p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
static void put32(uint8_t *p,uint32_t v){for(int i=0;i<4;i++)p[i]=(uint8_t)(v>>(8*i));}
static void load_state(const uint8_t *p){
 uint32_t *words[]={&g_eax,&g_ebx,&g_ecx,&g_edx,&g_esi,&g_edi,&g_ebp,&g_esp,&g_seh_ebp};
 for(int i=0;i<9;i++)*words[i]=get32(p+i*4);
 uint32_t bits=get32(p+36);memcpy(&g_df,&bits,4);bits=get32(p+40);memcpy(&g_fp_top,&bits,4);
 g_fp_cc=(uint16_t)(p[44]|(uint16_t)p[45]<<8);g_fp_control_word=(uint16_t)(p[46]|(uint16_t)p[47]<<8);
 for(int i=0;i<8;i++){uint64_t v=get32(p+48+i*8)|(uint64_t)get32(p+52+i*8)<<32;memcpy(&g_fp_stack[i],&v,8);}
 RecompXmm *x[]={&g_xmm0,&g_xmm1,&g_xmm2,&g_xmm3,&g_xmm4,&g_xmm5,&g_xmm6,&g_xmm7};
 for(int i=0;i<8;i++)for(int j=0;j<4;j++)x[i]->u[j]=get32(p+112+i*16+j*4);
 g_fs_base=get32(p+240);g_eflags=get32(p+244);bits=get32(p+248);memcpy(&g_fp_cmp,&bits,4);
 RecompMmx *m[]={&g_mm0,&g_mm1,&g_mm2,&g_mm3,&g_mm4,&g_mm5,&g_mm6,&g_mm7};
 for(int i=0;i<8;i++)for(int j=0;j<2;j++)m[i]->u[j]=get32(p+252+i*8+j*4);
}
static void store_state(uint8_t *p){
 uint32_t words[]={g_eax,g_ebx,g_ecx,g_edx,g_esi,g_edi,g_ebp,g_esp,g_seh_ebp};for(int i=0;i<9;i++)put32(p+i*4,words[i]);
 uint32_t bits;memcpy(&bits,&g_df,4);put32(p+36,bits);memcpy(&bits,&g_fp_top,4);put32(p+40,bits);
 p[44]=(uint8_t)g_fp_cc;p[45]=(uint8_t)(g_fp_cc>>8);p[46]=(uint8_t)g_fp_control_word;p[47]=(uint8_t)(g_fp_control_word>>8);
 for(int i=0;i<8;i++){uint64_t v;memcpy(&v,&g_fp_stack[i],8);put32(p+48+i*8,(uint32_t)v);put32(p+52+i*8,(uint32_t)(v>>32));}
 RecompXmm *x[]={&g_xmm0,&g_xmm1,&g_xmm2,&g_xmm3,&g_xmm4,&g_xmm5,&g_xmm6,&g_xmm7};for(int i=0;i<8;i++)for(int j=0;j<4;j++)put32(p+112+i*16+j*4,x[i]->u[j]);
 put32(p+240,g_fs_base);put32(p+244,g_eflags);memcpy(&bits,&g_fp_cmp,4);put32(p+248,bits);
 RecompMmx *m[]={&g_mm0,&g_mm1,&g_mm2,&g_mm3,&g_mm4,&g_mm5,&g_mm6,&g_mm7};for(int i=0;i<8;i++)for(int j=0;j<2;j++)put32(p+252+i*8+j*4,m[i]->u[j]);
}

static void route(unsigned line){
 uint32_t count=mem_get(0x1000);
 uint32_t values[8]={line,g_esp,(g_eax==0&&g_ebx==0&&g_ecx==0&&g_edx==0&&g_esi==0&&g_edi==0),g_current_irql,t_in_isr,t_gate_depth,memory[g_fs_base-0x740000+0x24],g_eflags};
 for(unsigned lane=0;lane<8;lane++){mem_word(0x4000+count*32+lane*4,values[lane]);}mem_word(0x1000,count+1);
 g_eax=0x31415926;g_mm7.u[0]=0x80000000;g_mm7.u[1]=0xffffffff;
 g_xmm1.u[0]=9;g_xmm1.u[1]=8;g_xmm1.u[2]=7;g_xmm1.u[3]=6;
 uint64_t bits=UINT64_C(0x7ff8000000001234);memcpy(&g_fp_stack[3],&bits,8);g_eflags^=0x1234;
 xbox_KfRaiseIrql(2);
}
static void vblank(void){route(0);}static void apu(void){route(1);}static void ohci(void){route(2);}
static uint64_t hash(const uint8_t *p,size_t n){uint64_t h=UINT64_C(14695981039346656037);for(size_t i=0;i<n;i++)h=(h^p[i])*UINT64_C(1099511628211);return h;}
void irq_reference(const uint8_t *before,uint8_t *out){
 memset(memory,0,sizeof(memory));memset((void *)&s_irq,0,sizeof(s_irq));memset(s_irq_post_ns,0,sizeof(s_irq_post_ns));
 for(unsigned i=0;i<16;i++)g_worker_stack_used[i]=0;
 load_state(before);g_xbox_mem_offset=(ptrdiff_t)memory-0x740000;
 g_current_irql=0;t_release_due=t_irql_counted=t_dispatch_gate_held=t_gate_depth=t_native_irq_masked=t_in_isr=0;
 g_irql_raised_count=g_native_irq_masked_count=s_transitions=s_gate_owner=s_irq_pending=s_irq_points_refused=0;
 s_irq_last_log_ns=0;irq_config();s_irq_run[0]=vblank;s_irq_run[1]=apu;s_irq_run[2]=ohci;
 for(unsigned i=0;i<8;i++)memory[0x1008+i]=(uint8_t)(UINT64_C(1000000000)>>(8*i));
 xbox_NativeInterruptDisable();unsigned lines[4]={2,0,1,1};
 for(unsigned lane=0;lane<4;lane++){uint64_t now=UINT64_C(1000000000)+lane*1000;for(unsigned i=0;i<8;i++)memory[0x1008+i]=(uint8_t)(now>>(8*i));xbox_IrqPost((int)lines[lane]);}
 xbox_IrqSafePoint();xbox_NativeInterruptEnableAfterShadow();
 int held[4];for(unsigned i=0;i<4;i++)held[i]=xbox_worker_stack_alloc();
 xbox_DispatchGateEnter();xbox_NativeInterruptDisable();for(int line=0;line<3;line++)xbox_IrqPost(line);
 xbox_NativeInterruptEnableAfterShadow();xbox_worker_stack_free(held[0]);xbox_IrqSafePoint();
 for(unsigned i=1;i<4;i++){xbox_worker_stack_free(held[i]);}xbox_DispatchGateLeave();
 store_state(out);XboxIrqStats stats;xbox_IrqStatsGet(&stats,1);
 LONG *groups[6]={stats.posted,stats.on_holder,stats.second_try,stats.forced,stats.ungated,stats.max_wait_us};
 for(unsigned group=0;group<6;group++)for(unsigned line=0;line<3;line++)put32(out+316+(group*3+line)*4,(uint32_t)groups[group][line]);
 put32(out+388,(uint32_t)stats.wait_logs);put32(out+392,(uint32_t)stats.refused);
 uint64_t ram=hash(memory,sizeof(memory));unsigned used=0;for(unsigned i=0;i<16;i++)used+=(unsigned)g_worker_stack_used[i];
 uint32_t fields[14]={g_current_irql,t_irql_counted,t_dispatch_gate_held,t_native_irq_masked,t_in_isr,t_release_due,(uint32_t)g_irql_raised_count,(uint32_t)g_native_irq_masked_count,(uint32_t)s_transitions,t_gate_depth,(uint32_t)s_irq_pending,used,(uint32_t)ram,(uint32_t)(ram>>32)};
 for(unsigned i=0;i<14;i++)put32(out+396+i*4,fields[i]);
}
/* Isolate the original signed32 LONG diagnostic on ABIs where long is 32 bits.
 * Linux64 compares a wider long before narrowing, so its maxima can become
 * negative or decrease. Observe that ABI difference without copying it to games.
 * Game code always uses the original Xbox/Windows signed32 conversion explicitly.
 */
int irq_wait_reference(uint64_t elapsed_us,uint32_t previous,uint32_t *out){
 uint64_t posted=UINT64_C(1000000000),now=posted+elapsed_us*UINT64_C(1000);
 for(unsigned i=0;i<8;i++)memory[0x1008+i]=(uint8_t)(now>>(8*i));
 memcpy((void *)&s_irq.max_wait_us[0],&previous,4);irq_note_wait(0,posted);
 memcpy(out,(const void *)&s_irq.max_wait_us[0],4);return (int)(sizeof(long)*8);
}
