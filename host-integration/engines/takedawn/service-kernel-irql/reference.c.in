static int s_trace=0;
static volatile LONG s_traced;
static int s_dispatch_gate;
static uint8_t memory[65536];
static LONG InterlockedCompareExchange(volatile LONG *p,LONG value,LONG expected){LONG old=*p;if(old==expected)*p=value;return old;}
static LONG InterlockedExchange(volatile LONG *p,LONG value){LONG old=*p;*p=value;return old;}
static LONG delta(volatile LONG *p,uint32_t d){uint32_t n;memcpy(&n,(const void *)p,4);n+=d;memcpy((void *)p,&n,4);return *p;}
static LONG InterlockedIncrement(volatile LONG *p){return delta(p,1);}
static LONG InterlockedDecrement(volatile LONG *p){return delta(p,UINT32_MAX);}
static unsigned long GetCurrentThreadId(void){return 1;}
static void dispatch_gate_once(void){}
static void EnterCriticalSection(int *p){(void)p;}
static int TryEnterCriticalSection(int *p){(void)p;return 1;}
static void LeaveCriticalSection(int *p){(void)p;}
static int xbox_ProfOn(void){return 0;}
static long long xbox_ProfNowUs(void){return 0;}
static void xbox_ProfWait(int k,long long v){(void)k;(void)v;}
static void irql_holder_add(void *p){(void)p;}
static void irql_holder_drop(void){}
static int recomp_env(int key){(void)key;return 0;}
static void trace(uint64_t kind,uint32_t flags,uint8_t new_level){
 uint32_t count;memcpy(&count,memory+0x1000,4);if(count>=256)return;
 uint64_t v[16]={kind,g_current_irql,t_irql_counted,t_dispatch_gate_held,t_native_irq_masked,t_in_isr,t_release_due,(uint32_t)g_irql_raised_count,(uint32_t)g_native_irq_masked_count,(uint32_t)s_transitions,t_gate_depth,flags,memory[0x24],new_level,0,0};
 for(unsigned i=0;i<16;i++)for(unsigned j=0;j<8;j++)memory[0x4000+count*128+i*8+j]=(uint8_t)(v[i]>>(j*8));
 count++;memcpy(memory+0x1000,&count,4);
}
static void xbox_log(int level,int area,const char *text,...){
 (void)level;(void)area;va_list ap;va_start(ap,text);(void)va_arg(ap,int);int n=va_arg(ap,int);va_end(ap);
 trace(strstr(text,"KfRaiseIrql:")?5:6,0,(uint8_t)n);
}
static void irq_release_point(void){trace(3,g_eflags,0);}
static void release_window(void){trace(2,g_eflags,0);}
static void (*s_irq_release_hook)(void)=release_window;
static void xbox_SpinWake(void){trace(4,0,0);}
static void irql_release_due(void);
static void xbox_IrqSafePoint(void);
int xbox_IrqlEnterInterrupt(int level);
void xbox_IrqlLeaveInterrupt(int saved);
KIRQL xbox_KfRaiseIrql(KIRQL level);
