[[games]]
id = "com.gamepkg.halo"
description = "Play Halo: Combat Evolved by building the pinned OpenCE engine on your machine. The shipped target is 32-bit Linux (i686). 32-bit Windows can be cross-compiled and runs on Windows. 64-bit builds are not ready. You supply your own Xbox disc image or extracted maps folder. No Halo assets and no OpenCE source are in this package."
title = "Halo: Combat Evolved — i686, bring your Xbox data"
version = "0.1.0"
requires_rom = false
download_url = "https://github.com/centrexity/GamePKG_Ports/releases/download/v0.1.6/halo.gamepkg"
